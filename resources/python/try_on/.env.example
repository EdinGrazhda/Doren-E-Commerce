# Export these variables in the Python service process; this file is not loaded automatically.
# Use the same randomly generated secret (at least 32 characters) in Laravel's .env.
TRY_ON_SERVICE_TOKEN=
TRY_ON_WEIGHTS_DIR=/absolute/path/to/persistent/weights
HF_HOME=/absolute/path/to/persistent/huggingface-cache
TRY_ON_DEVICE=cuda
TRY_ON_STEPS=30

# Python 3.10+ on a host with working CUDA/PyTorch support:
# python -m venv .venv
# .venv/bin/pip install -r resources/python/try_on/requirements.txt
# .venv/bin/python resources/python/try_on/download_weights.py
# .venv/bin/python -m uvicorn server:app --app-dir resources/python/try_on --host 127.0.0.1 --port 8100 --workers 1 --no-access-log
# For another host, expose only over a private network or authenticated TLS reverse proxy.
# Use one Laravel try-ons queue worker per GPU, plus the Laravel scheduler.
# Before enabling TRY_ON_ENABLED in Laravel, verify /health with the Bearer token
# and smoke-test real tops, bottoms and dresses on representative full-body photos.
